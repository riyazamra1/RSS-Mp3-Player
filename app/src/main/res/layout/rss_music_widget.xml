<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:padding="12dp" android:gravity="center_vertical" android:background="#202127">
    <ImageView android:id="@+id/widget_art" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop"
        android:src="@android:drawable/ic_media_play" android:contentDescription="Album artwork" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RSS Music" android:textColor="#FFFFFF" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to choose music" android:textColor="#C8C8D0" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageButton android:id="@+id/widget_previous" android:layout_width="36dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/widget_play" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" />
            <ImageButton android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
            <ImageButton android:id="@+id/widget_queue" android:layout_width="36dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="Open queue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
